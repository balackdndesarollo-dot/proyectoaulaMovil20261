{
  "expo": {
    "name": "superapp",
    "slug": "superapp",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icono.png",

    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/icono.png",
